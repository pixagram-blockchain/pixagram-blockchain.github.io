  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  },
  "file_handlers": [
    {
      "action": "/trending/?pwa=open-file",
      "accept": {
        "image/png": [
          ".png"
        ],
        "image/jpeg": [
          ".jpg",
          ".jpeg"
        ],
        "image/webp": [
          ".webp"
        ],
        "image/gif": [
          ".gif"
        ],
        "image/bmp": [
          ".bmp"
        ],
        "image/avif": [
          ".avif"
        ],
        "image/heic": [
          ".heic"
        ],
        "image/heif": [
          ".heif"
        ]
      },
      "icons": [
        {
          "src": "/src/images/manifest/icons/icon-256.png",
          "sizes": "256x256",
          "type": "image/png",
          "purpose": "any"
        }
      ],
      "launch_type": "single-client"
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+pixagram",
      "url": "/trending/?pwa=protocol&uri=%s"
    }
  ],
  "share_target": {
    "action": "/share-target/",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "image",
          "accept": [
            "image/*",
            ".png",
            ".jpg",
            ".jpeg",
            ".webp",
            ".gif",
            ".avif",
            ".heic",
            ".heif"
          ]
        }
      ]
    }
  },
  "note_taking": {
    "new_note_url": "/trending/?pwa=create"
  },
  "tab_strip": {
    "home_tab": {
      "scope_patterns": [
        {
          "pathname": "/"
        }
      ]
    },
    "new_tab_button": {
      "url": "/trending/"
    }
  },
  "scope_extensions": [
    {
      "type": "origin",
      "origin": "https://pixa.org"
    }
  ],
  "widgets": [
    {
      "name": "Pixagram trending",
      "short_name": "Trending",
      "description": "The three artworks trending on Pixagram right now, with quick links to create and browse.",
      "tag": "pixagram-trending",
      "template": "pixagram-trending",
      "ms_ac_template": "/widgets/trending-template.json",
      "data": "/widgets/trending-data.json",
      "type": "application/json",
      "auth": false,
      "update": 3600,
      "multiple": false,
      "icons": [
        {
          "src": "/src/images/manifest/icons/icon-96.png",
          "sizes": "96x96",
          "type": "image/png",
          "purpose": "any"
        },
        {
          "src": "/src/images/manifest/icons/icon-256.png",
          "sizes": "256x256",
          "type": "image/png",
          "purpose": "any"
        }
      ],
      "screenshots": [
        {
          "src": "/src/images/manifest/widgets/trending-widget.png",
          "sizes": "300x304",
          "type": "image/png",
          "label": "Pixagram trending widget"
        }
      ]
    }
  ],
  "handle_links": "preferred",
  "edge_side_panel": {
    "preferred_width": 960
  },
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://pixagram.com/manifest.json"
    }
  ]
}
