  "shortcuts": [
    {
      "name": "Create pixel art",
      "short_name": "Create",
      "description": "Convert a photo or a prompt into pixel art",
      "url": "/trending/?pwa=create",
      "icons": [
        {
          "src": "/src/images/manifest/icons/shortcut-create-96.png",
          "sizes": "96x96",
          "type": "image/png",
          "purpose": "any"
        },
        {
          "src": "/src/images/manifest/icons/shortcut-create-192.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "any"
        },
